# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=remotyx

# Resend (https://resend.com) — optional: emails are skipped if empty
RESEND_API_KEY=
# Sender must be on a domain verified in Resend, e.g. hello@remotyx.com
FROM_EMAIL=Remotyx <hello@remotyx.com>
# Where new requests are sent
NOTIFY_EMAIL=you@example.com

# Public site URL (used for sitemap)
NEXT_PUBLIC_SITE_URL=https://remotyx.com
